{
  "schema_version": 1,
  "id": "llm-node",
  "name": "Raw LLM Call",
  "version": 1,
  "description": "Input -> LLM -> Output. Shows the difference between an Agent node (instructions + tools + memory) and a raw LLM node: one prompt template, one model call, nothing else.",
  "inputs": [
    {
      "name": "topic",
      "type": "string",
      "required": true,
      "description": "A topic to write a haiku about"
    }
  ],
  "nodes": [
    { "id": "input-1", "type": "input", "label": "Input", "position": { "x": 80, "y": 160 }, "config": {} },
    {
      "id": "llm-1",
      "type": "llm",
      "label": "Haiku",
      "position": { "x": 380, "y": 160 },
      "config": {
        "model": "default",
        "prompt_template": "Write a short, cheerful haiku. Topic: {{input}}",
        "temperature": 0.7,
        "max_tokens": 100
      }
    },
    { "id": "output-1", "type": "output", "label": "Output", "position": { "x": 680, "y": 160 }, "config": {} }
  ],
  "edges": [
    { "id": "e1", "source": "input-1", "target": "llm-1" },
    { "id": "e2", "source": "llm-1", "target": "output-1" }
  ],
  "variables": {},
  "policies": {},
  "metadata": { "example": true, "node_type_demo": "llm" }
}
