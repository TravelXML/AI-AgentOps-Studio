{
  "schema_version": 1,
  "id": "rag-agent",
  "name": "RAG Q&A",
  "version": 1,
  "description": "Input -> RAG -> Agent -> Output. The RAG node retrieves the most relevant chunks from a knowledge base (seeded automatically with a short doc about AgentQ) and hands them to the agent as context. Try asking 'what is a flow made of' or 'how does human approval work'.",
  "inputs": [
    {
      "name": "query",
      "type": "string",
      "required": true,
      "description": "A question about AgentQ"
    }
  ],
  "nodes": [
    { "id": "input-1", "type": "input", "label": "Input", "position": { "x": 60, "y": 160 }, "config": {} },
    {
      "id": "rag-1",
      "type": "rag",
      "label": "Retrieve",
      "position": { "x": 320, "y": 160 },
      "config": {
        "knowledge_base_id": "__SEEDED_KNOWLEDGE_BASE_ID__",
        "top_k": 3,
        "min_score": 0.0
      }
    },
    {
      "id": "agent-1",
      "type": "agent",
      "label": "Answer",
      "position": { "x": 620, "y": 160 },
      "config": {
        "name": "Answer",
        "description": "Answers using only the retrieved context.",
        "instructions": "Answer the question using only the relevant context provided above it. If the context doesn't cover it, say so.",
        "model": "default",
        "temperature": 0.1,
        "max_tokens": 512
      }
    },
    { "id": "output-1", "type": "output", "label": "Output", "position": { "x": 920, "y": 160 }, "config": {} }
  ],
  "edges": [
    { "id": "e1", "source": "input-1", "target": "rag-1" },
    { "id": "e2", "source": "rag-1", "target": "agent-1" },
    { "id": "e3", "source": "agent-1", "target": "output-1" }
  ],
  "variables": {},
  "policies": {},
  "metadata": { "example": true, "node_type_demo": "rag" }
}
