# Copy this file to .env and adjust as needed. The app boots and every automated test passes
# with NO changes to this file — MockLLM/Ollama require no cloud credentials (spec section 56).

# --- Core ---
APP_ENV=development
# Used to derive the local secrets-at-rest encryption key. Change this for any real deployment.
APP_SECRET=dev-insecure-secret-change-me

# --- Database & cache ---
DATABASE_URL=postgresql+asyncpg://agentq:agentq@localhost:5432/agentq
REDIS_URL=redis://localhost:6379/0

# --- Model gateway ---
# "mock" needs nothing. Point at a local Ollama daemon for real local-model runs.
DEFAULT_MODEL_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud providers — only needed if you add a Settings -> Models entry that uses them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Web ---
# Browser-visible API base URL (the browser calls this directly — it must be reachable from the
# host running your browser, not just from inside the docker network).
NEXT_PUBLIC_API_URL=http://localhost:8000
AGENTQ_API_URL=http://api:8000
